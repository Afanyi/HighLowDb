    # Copy to deploy/server.env and chmod 600; values are parsed, never sourced.
# Existing TradingSupport SSH alias, with strict host verification.
AS_HOST=live
AS_KEY=~/.ssh/live-server.key
# Optional private host-key file for an explicit direct target (no SSH aliases/agent):
# AS_KNOWN_HOSTS=/absolute/path/to/verified-known-hosts
