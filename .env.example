# Copy to .env and fill in. Never commit .env.
# Trading 212 API key (needs instrument metadata access). Read-only scope recommended.
T212_API_KEY=
# Secret for key+secret API keys; leave empty for a legacy key-only API key.
T212_API_SECRET=
# live or demo (must match the account the key belongs to).
T212_ENVIRONMENT=live
# Daily sync time (UTC, weekdays). 14:45 is after the US market opens.
SYNC_TIME_UTC=14:45
