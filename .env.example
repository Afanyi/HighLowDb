# Copy to .env and fill in. Never commit .env.
# Trading 212 API key (needs instrument metadata access). Read-only scope recommended.
T212_API_KEY=
# Secret for key+secret API keys; leave empty for a legacy key-only API key.
T212_API_SECRET=
# live or demo (must match the account the key belongs to).
T212_ENVIRONMENT=live
# Daily sync time (UTC, weekdays). 14:45 is after the US market opens.
SYNC_TIME_UTC=14:45
# Seconds between Yahoo requests during the stock sync.
YAHOO_REQUEST_DELAY=0.5

# --- Crypto (CoinGecko for the coin list and prices) ---
# Free CoinGecko Demo API key from https://www.coingecko.com/en/api
COINGECKO_API_KEY=
# Currency crypto prices are quoted in (any CoinGecko vs_currency, e.g. usd, eur).
# Changing it later needs a fresh crypto DB: stored yearly highs/lows stay in the old currency.
CRYPTO_VS_CURRENCY=usd
# Daily crypto sync time (UTC, every day: crypto trades 24/7).
CRYPTO_SYNC_TIME_UTC=02:00
# Max number of coins to backfill yearly highs/lows for per run (0 disables backfill).
CRYPTO_HISTORY_CALLS_PER_RUN=200
# Crypto database file, separate from the stock DB so the two syncs never lock each other.
# Docker already sets /data/crypto.db (on the volume); only set this when running outside Docker.
# CRYPTO_DB_PATH=/data/crypto.db
